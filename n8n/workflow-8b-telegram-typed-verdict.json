{
  "name": "bKash 8b — Typed validation (<order> ✅/❌) → verdict",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "wf8b-trigger",
      "name": "Telegram Trigger (message)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        180,
        360
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse a group message. Only the authorized group is processed; everything\n// that is not /id or a verdict is ignored silently.\nconst upd = $input.first().json || {};\nconst msg = upd.message || (upd.body && upd.body.message) || {};\nconst chat = msg.chat || {};\nconst from = msg.from || {};\nconst text = (msg.text || '').trim();\nconst chatId = chat.id;\nconst messageId = msg.message_id;\nconst fromName = ([from.first_name, from.last_name].filter(Boolean).join(' ') + (from.username ? ' (@' + from.username + ')' : '')).trim() || 'unknown';\nconst fromId = from.id;\n\nconst ALLOWED_CHAT = -5162751576;\nif (chatId !== ALLOWED_CHAT) { return []; }            // ignore other chats\n\n// Temporary helper: anyone in the group can get their numeric id.\nconst t = text.toLowerCase();\nif (t === '/id' || t.indexOf('/id ') === 0 || t.indexOf('/id@') === 0) {\n  return [{ json: { kind: 'id', replyText: 'Your ID: ' + fromId + ' (' + (from.first_name || '') + ')', chatId, messageId } }];\n}\n\n// Verdict: '<order#> OK-emoji' (confirm) or 'X-emoji' (reject); tolerant of spaces/case.\nconst m = text.match(/^\\s*([A-Za-z0-9-]+)\\s*(✅|❌)\\s*$/);\nif (!m) { return []; }                                  // ignore anything else\nconst orderNumber = m[1].toUpperCase();\nconst action = m[2] === '✅' ? 'confirm' : 'reject';\n\n// Authorized Telegram ids (an id is not secret) - in-workflow constant, no VPS/env.\nconst AUTHORIZED_IDS = ['1467933699'];   // Malamine; add associate id here (via /id)\nconst authorized = AUTHORIZED_IDS.includes(String(fromId));\nif (!authorized) {\n  return [{ json: { kind: 'unauth', replyText: '🚫 Not authorized.', chatId, messageId } }];\n}\nreturn [{ json: { kind: 'verdict', orderNumber, action, chatId, messageId, fromName } }];"
      },
      "id": "wf8b-parse",
      "name": "Parse message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.kind }}",
              "rightValue": "verdict",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "wf8b-is-verdict",
      "name": "IF verdict",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        360
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "order_number",
              "condition": "eq",
              "keyValue": "={{ $json.orderNumber }}"
            }
          ]
        }
      },
      "id": "wf8b-lookup",
      "name": "Supabase — Lookup by order_number",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        840,
        300
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase French Beauty"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Exactly one order must match the number, and it must still be awaiting\n// verification. Otherwise build a clear reply and stop.\nconst p = $('Parse message').item.json;\nconst chatId = p.chatId, messageId = p.messageId, fromName = p.fromName, orderNumber = p.orderNumber, action = p.action;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (rows.length === 0) return [{ json: { proceed: false, chatId, messageId, replyText: '❓ Order ' + orderNumber + ' not found.' } }];\nif (rows.length > 1) return [{ json: { proceed: false, chatId, messageId, replyText: '⚠️ Multiple orders match ' + orderNumber + ' — aborting, verify manually.' } }];\nconst row = rows[0];\nif (row.payment_status !== 'paiement_a_verifier') {\n  const already = (row.payment_status === 'paye' || row.payment_status === 'refuse');\n  const txt = already\n    ? '⚠️ Already handled — no change (' + orderNumber + ' is ' + row.payment_status + ').'\n    : '⚠️ Order ' + orderNumber + ' not awaiting verification (is ' + row.payment_status + ').';\n  return [{ json: { proceed: false, chatId, messageId, replyText: txt } }];\n}\nconst addr = row.shipping_address || {};\nreturn [{ json: { proceed: true, action, orderId: row.id, orderNumber, chatId, messageId, fromName, email: addr.email, firstName: addr.firstName, totalBdt: row.total_bdt } }];"
      },
      "id": "wf8b-decide",
      "name": "Decide verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
