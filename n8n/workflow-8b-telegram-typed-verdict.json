    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <no-reply@frenchbeautybd.com>', to: [ $('Decide verdict').item.json.email ], subject: 'About your payment for order ' + $('Decide verdict').item.json.orderNumber, html: '<div style=\"margin:0;padding:24px;background:#FAF8F5;font-family:Helvetica,Arial,sans-serif;color:#1A1A1A;\"><div style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E8E2DA;border-radius:8px;overflow:hidden;\"><div style=\"padding:22px 32px;border-bottom:1px solid #E8E2DA;\"><span style=\"font-family:Georgia,serif;font-size:18px;letter-spacing:2px;color:#C9513A;\">FRENCH BEAUTY BD</span></div><div style=\"padding:32px;\"><h1 style=\"margin:0 0 18px;font-family:Georgia,serif;font-size:24px;font-weight:normal;color:#1A1A1A;\">We could not confirm your payment</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Hi ' + (($('Decide verdict').item.json.firstName) || 'there') + ',</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">We were unable to match a payment to your order <b>' + $('Decide verdict').item.json.orderNumber + '</b>.</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">If you have already paid, simply reply to this email with a clearer screenshot of your bKash/Nagad confirmation, or the TrxID, and we will check again.</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Without a valid payment, your order will be cancelled automatically within 24 hours. No action is needed if you did not complete the payment.</p><div style=\"margin:26px 0;height:1px;background:#E8E2DA;\"></div><p style=\"margin:0;font-size:12px;line-height:1.6;color:#6B6B6B;\">French Beauty BD — authentic French cosmetics, delivered to Bangladesh.</p></div></div></div>' } }}",
        "options": {}
      },
