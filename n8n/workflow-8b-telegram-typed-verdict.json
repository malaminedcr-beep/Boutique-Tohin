    {
      "parameters": {
        "jsCode": "const d = $('Decide verdict').item.json;\nconst upd = $input.first() ? ($input.first().json || {}) : {};\nconst applied = !!upd.order_number;   // guarded update returned the row\nconst txt = applied\n  ? '✅ ' + d.orderNumber + ' confirmed by ' + d.fromName\n  : '⚠️ Already handled — no change (' + d.orderNumber + ').';\nreturn [{ json: { replyText: txt, chatId: d.chatId, messageId: d.messageId } }];"
      },
