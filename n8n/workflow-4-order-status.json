{
  "name": "FBD 4 — Order status → email client (Resend)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-status-update",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf4-webhook",
      "name": "Webhook Order Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 320]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.order_status }}",
                    "rightValue": "confirmed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "confirmed"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.order_status }}",
                    "rightValue": "shipped",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "shipped"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.order_status }}",
                    "rightValue": "delivered",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "delivered"
            }
          ]
        },
        "options": {}
      },
      "id": "wf4-switch",
      "name": "Switch order_status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <no-reply@frenchbeautybd.com>', to: [ $json.body.email ], subject: 'Your French Beauty BD order ' + $json.body.order_number + ' is confirmed', html: '<div style=\"margin:0;padding:24px;background:#FAF8F5;font-family:Helvetica,Arial,sans-serif;color:#1A1A1A;\"><div style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E8E2DA;border-radius:8px;overflow:hidden;\"><div style=\"padding:22px 32px;border-bottom:1px solid #E8E2DA;\"><span style=\"font-family:Georgia,serif;font-size:18px;letter-spacing:2px;color:#C9513A;\">FRENCH BEAUTY BD</span></div><div style=\"padding:32px;\"><h1 style=\"margin:0 0 18px;font-family:Georgia,serif;font-size:26px;font-weight:normal;color:#1A1A1A;\">Order confirmed</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Hi ' + ($json.body.first_name || 'there') + ',</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Thank you for your order. We have confirmed <b>' + $json.body.order_number + '</b> and it is now being prepared for shipment from France. You will hear from us again the moment it is on its way.</p><div style=\"margin:26px 0 0;\"><span style=\"display:inline-block;padding:10px 18px;background:#C9513A;color:#FFFFFF;font-size:13px;letter-spacing:1px;border-radius:4px;\">BEING PREPARED</span></div><div style=\"margin:26px 0;height:1px;background:#E8E2DA;\"></div><p style=\"margin:0;font-size:12px;line-height:1.6;color:#6B6B6B;\">French Beauty BD — authentic French cosmetics, delivered to Bangladesh.</p></div></div></div>' } }}",
        "options": {}
      },
      "id": "wf4-mail-confirmed",
      "name": "Resend — Confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 140],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <no-reply@frenchbeautybd.com>', to: [ $json.body.email ], subject: 'Your order ' + $json.body.order_number + ' has shipped', html: '<div style=\"margin:0;padding:24px;background:#FAF8F5;font-family:Helvetica,Arial,sans-serif;color:#1A1A1A;\"><div style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E8E2DA;border-radius:8px;overflow:hidden;\"><div style=\"padding:22px 32px;border-bottom:1px solid #E8E2DA;\"><span style=\"font-family:Georgia,serif;font-size:18px;letter-spacing:2px;color:#C9513A;\">FRENCH BEAUTY BD</span></div><div style=\"padding:32px;\"><h1 style=\"margin:0 0 18px;font-family:Georgia,serif;font-size:26px;font-weight:normal;color:#1A1A1A;\">On its way</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Hi ' + ($json.body.first_name || 'there') + ',</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Good news — your order <b>' + $json.body.order_number + '</b> has been shipped and is on its way to you.</p>' + ($json.body.tracking_number ? '<div style=\"margin:22px 0;padding:14px 18px;background:#FAF8F5;border:1px solid #E8E2DA;border-radius:6px;\"><p style=\"margin:0;font-size:13px;color:#6B6B6B;\">Tracking number</p><p style=\"margin:4px 0 0;font-size:16px;font-family:Georgia,serif;color:#1A1A1A;\">' + $json.body.tracking_number + '</p></div>' : '') + '<div style=\"margin:26px 0;height:1px;background:#E8E2DA;\"></div><p style=\"margin:0;font-size:12px;line-height:1.6;color:#6B6B6B;\">French Beauty BD — authentic French cosmetics, delivered to Bangladesh.</p></div></div></div>' } }}",
        "options": {}
      },
      "id": "wf4-mail-shipped",
      "name": "Resend — Shipped",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 320],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <no-reply@frenchbeautybd.com>', to: [ $json.body.email ], subject: 'Your order ' + $json.body.order_number + ' has been delivered', html: '<div style=\"margin:0;padding:24px;background:#FAF8F5;font-family:Helvetica,Arial,sans-serif;color:#1A1A1A;\"><div style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E8E2DA;border-radius:8px;overflow:hidden;\"><div style=\"padding:22px 32px;border-bottom:1px solid #E8E2DA;\"><span style=\"font-family:Georgia,serif;font-size:18px;letter-spacing:2px;color:#C9513A;\">FRENCH BEAUTY BD</span></div><div style=\"padding:32px;\"><h1 style=\"margin:0 0 18px;font-family:Georgia,serif;font-size:26px;font-weight:normal;color:#1A1A1A;\">Delivered — thank you</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Hi ' + ($json.body.first_name || 'there') + ',</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Your order <b>' + $json.body.order_number + '</b> has been delivered. We hope you love your French Beauty products, and we would be delighted to see you again.</p><div style=\"margin:26px 0;height:1px;background:#E8E2DA;\"></div><p style=\"margin:0;font-size:12px;line-height:1.6;color:#6B6B6B;\">French Beauty BD — authentic French cosmetics, delivered to Bangladesh.</p></div></div></div>' } }}",
        "options": {}
      },
      "id": "wf4-mail-delivered",
      "name": "Resend — Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 500],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    }
  ],
  "connections": {
    "Webhook Order Status": {
      "main": [[{ "node": "Switch order_status", "type": "main", "index": 0 }]]
    },
    "Switch order_status": {
      "main": [
        [{ "node": "Resend — Confirmed", "type": "main", "index": 0 }],
        [{ "node": "Resend — Shipped", "type": "main", "index": 0 }],
        [{ "node": "Resend — Delivered", "type": "main", "index": 0 }]
      ]
