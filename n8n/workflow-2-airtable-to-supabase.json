{
  "name": "bKash 2 — Airtable → Supabase (validation manuelle)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bkash-airtable-validation",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf2-webhook",
      "name": "Webhook Airtable",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.body.statut }}",
              "rightValue": "Paye",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.statut }}",
              "rightValue": "Refuse",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "wf2-if",
      "name": "IF statut = Paye/Refuse",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "orders",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $json.body.order_id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "payment_status", "fieldValue": "={{ $json.body.statut === 'Paye' ? 'paye' : 'refuse' }}" },
            { "fieldId": "verified_by", "fieldValue": "={{ $json.body.verifie_par || 'airtable' }}" },
            { "fieldId": "verified_at", "fieldValue": "={{ $now.toISO() }}" }
          ]
        }
      },
      "id": "wf2-supabase",
      "name": "Supabase — Update orders",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [720, 240],
      "credentials": {
        "supabaseApi": { "id": "", "name": "Supabase French Beauty" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <onboarding@resend.dev>', to: [ $('Supabase — Update orders').item.json.shipping_address.email ], subject: ($('Webhook Airtable').item.json.body.statut === 'Paye' ? 'Paiement confirmé — commande ' + $('Webhook Airtable').item.json.body.order_number : 'Paiement non validé — commande ' + $('Webhook Airtable').item.json.body.order_number), html: ($('Webhook Airtable').item.json.body.statut === 'Paye' ? '<p>Bonjour,</p><p>Votre paiement bKash pour la commande <b>' + $('Webhook Airtable').item.json.body.order_number + '</b> a été confirmé. Merci pour votre confiance !</p><p>— French Beauty BD</p>' : '<p>Bonjour,</p><p>Le paiement bKash de votre commande <b>' + $('Webhook Airtable').item.json.body.order_number + '</b> n a pas pu être validé. Contactez-nous pour régulariser.</p><p>— French Beauty BD</p>') } }}",
        "options": {}
      },
      "id": "wf2-notif",
      "name": "Resend — Email client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 240],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    }
  ],
  "connections": {
    "Webhook Airtable": {
      "main": [[{ "node": "IF statut = Paye/Refuse", "type": "main", "index": 0 }]]
    },
    "IF statut = Paye/Refuse": {
      "main": [
        [{ "node": "Supabase — Update orders", "type": "main", "index": 0 }],
        []
      ]
    },
    "Supabase — Update orders": {
      "main": [[{ "node": "Resend — Email client", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
