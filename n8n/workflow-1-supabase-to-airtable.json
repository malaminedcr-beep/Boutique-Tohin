    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.body.record.payment_status }}",
              "rightValue": "paiement_a_verifier",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.record.payment_method }}",
              "rightValue": "bkash",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.old_record ? $json.body.old_record.payment_status : '' }}",
              "rightValue": "paiement_a_verifier",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-if",
      "name": "Filtre paiement_a_verifier",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/app8wnK5LRxNVaXq1/Verifications",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"fields\": { \"order_id\": $json.body.record.id, \"order_number\": $json.body.record.order_number, \"client_nom\": ((($json.body.record.shipping_address || {}).firstName || '') + ' ' + (($json.body.record.shipping_address || {}).lastName || '')).trim(), \"client_telephone\": ($json.body.record.shipping_address || {}).phone, \"montant\": $json.body.record.total_bdt, \"trxid\": $json.body.record.trxid, \"soumis_le\": $json.body.record.trxid_submitted_at, \"statut\": \"A verifier\" } } }}",
        "options": {}
      },
      "id": "wf1-airtable",
      "name": "Airtable — Créer vérification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "airtableTokenApi": { "id": "", "name": "Airtable Paiements bKash" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-5162751576",
        "text": "=🔔 Nouveau paiement à vérifier : {{ $('Webhook Supabase').item.json.body.record.order_number }} — {{ $('Webhook Supabase').item.json.body.record.total_bdt }} BDT — TrxID {{ $('Webhook Supabase').item.json.body.record.trxid }}",
        "additionalFields": {}
      },
      "id": "wf1-notif",
      "name": "Telegram — Notif admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 200],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram bKash Bot" }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.frenchbeautybd.com/api/orders/{{ $('Webhook Supabase').item.json.body.record.id }}/slip",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } }
        }
      },
      "id": "wf1-fetchpdf",
      "name": "Fetch bon de commande (PDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 400],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Supabase Service Bearer" }
      }
    },
    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{ json: { file: buf.toString('base64') } }];"
      },
      "id": "wf1-tobase64",
      "name": "PDF → base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 400],
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://content.airtable.com/v0/app8wnK5LRxNVaXq1/{{ $('Airtable — Créer vérification').item.json.id }}/fldWgQe2Biz7LbWFc/uploadAttachment",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contentType: 'application/pdf', filename: 'bon-commande-' + $('Webhook Supabase').item.json.body.record.order_number + '.pdf', file: $json.file } }}",
