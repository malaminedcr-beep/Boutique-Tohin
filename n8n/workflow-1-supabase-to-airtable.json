{
  "name": "bKash 1 — Supabase → Airtable (nouvelle vérification)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bkash-new-verification",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf1-webhook",
