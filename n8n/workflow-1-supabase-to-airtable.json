{
  "name": "bKash 1 — Supabase → Airtable (nouvelle vérification)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bkash-new-verification",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf1-webhook",
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.body.record.payment_status }}",
              "rightValue": "paiement_a_verifier",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.record.payment_method }}",
              "rightValue": "bkash",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.old_record ? $json.body.old_record.payment_status : '' }}",
              "rightValue": "paiement_a_verifier",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-if",
      "name": "Filtre paiement_a_verifier",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://api.airtable.com/v0/app8wnK5LRxNVaXq1/Verifications",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { performUpsert: { fieldsToMergeOn: ['order_id'] }, records: [ { fields: { order_id: $json.body.record.id, order_number: $json.body.record.order_number, client_nom: ((($json.body.record.shipping_address || {}).firstName || '') + ' ' + (($json.body.record.shipping_address || {}).lastName || '')).trim(), client_telephone: ($json.body.record.shipping_address || {}).phone, montant: $json.body.record.total_bdt, trxid: $json.body.record.trxid, soumis_le: $json.body.record.trxid_submitted_at, statut: 'A verifier' } } ] } }}",
        "options": {}
      },
      "id": "wf1-airtable",
      "name": "Airtable — Upsert vérification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "airtableTokenApi": { "id": "", "name": "Airtable Personal Access Token account" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-5162751576",
        "text": "=🔔 Nouveau paiement à vérifier : {{ $('Webhook Supabase').item.json.body.record.order_number }} — {{ $('Webhook Supabase').item.json.body.record.total_bdt }} BDT — TrxID {{ $('Webhook Supabase').item.json.body.record.trxid }}",
        "additionalFields": {}
      },
      "id": "wf1-notif",
      "name": "Telegram — Notif admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 220],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram account" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <no-reply@frenchbeautybd.com>', to: [ ($('Webhook Supabase').item.json.body.record.shipping_address || {}).email ], subject: 'Payment received — order ' + $('Webhook Supabase').item.json.body.record.order_number + ' is under review', html: '<div style=\"margin:0;padding:24px;background:#FAF8F5;font-family:Helvetica,Arial,sans-serif;color:#1A1A1A;\"><div style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E8E2DA;border-radius:8px;overflow:hidden;\"><div style=\"padding:22px 32px;border-bottom:1px solid #E8E2DA;\"><span style=\"font-family:Georgia,serif;font-size:18px;letter-spacing:2px;color:#C9513A;\">FRENCH BEAUTY BD</span></div><div style=\"padding:32px;\"><h1 style=\"margin:0 0 18px;font-family:Georgia,serif;font-size:26px;font-weight:normal;color:#1A1A1A;\">Payment received</h1><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">Hi ' + (($('Webhook Supabase').item.json.body.record.shipping_address || {}).firstName || 'there') + ',</p><p style=\"margin:0 0 16px;font-size:15px;line-height:1.65;\">We have received your bKash payment reference for order <b>' + $('Webhook Supabase').item.json.body.record.order_number + '</b> (' + $('Webhook Supabase').item.json.body.record.total_bdt + ' BDT). Our team is verifying it now — you will receive a confirmation email as soon as it is validated.</p><div style=\"margin:26px 0 0;\"><span style=\"display:inline-block;padding:10px 18px;background:#C9513A;color:#FFFFFF;font-size:13px;letter-spacing:1px;border-radius:4px;\">UNDER VERIFICATION</span></div><div style=\"margin:26px 0;height:1px;background:#E8E2DA;\"></div><p style=\"margin:0;font-size:12px;line-height:1.6;color:#6B6B6B;\">French Beauty BD — authentic French cosmetics, delivered to Bangladesh.</p></div></div></div>' } }}",
        "options": {}
      },
      "id": "wf1-emailrecu",
      "name": "Resend — Paiement reçu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 400],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 10,
        "unit": "minutes",
        "options": {}
      },
      "id": "wf1-wait",
      "name": "Attendre 10 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [980, 600],
      "webhookId": "wf1-reminder-wait"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $('Webhook Supabase').item.json.body.record.id }}" }
          ]
        }
      },
      "id": "wf1-recheck",
      "name": "Supabase — Revérifier statut",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 600],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": { "id": "", "name": "Supabase French Beauty" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Relance marchand : après chaque attente de 10 min, on re-lit l'état RÉEL de la\n// commande dans Supabase. Tant qu'elle est encore 'paiement_a_verifier', on relance.\n// Compteur via $runIndex (0 au 1er passage) → reminderNumber 1, 2, 3.\n// Aucune colonne DB : l'état de la boucle vit dans l'exécution n8n (Wait persistant).\n// Max 3 relances (10/20/30 min) puis stop, pour ne pas spammer si le marchand est absent.\nconst row = $input.first() ? ($input.first().json || {}) : {};\nconst stillPending = row.payment_status === 'paiement_a_verifier';\nconst reminderNumber = $runIndex + 1;        // 1, 2, 3\nconst canContinue = reminderNumber < 3;      // relancer encore APRÈS celle-ci ?\nreturn [{ json: { stillPending, reminderNumber, canContinue } }];"
      },
      "id": "wf1-decide",
      "name": "Décider relance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 600]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.stillPending }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-if-pending",
      "name": "IF encore en attente",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1640, 600]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-5162751576",
        "text": "=⏰ Reminder ({{ $('Décider relance').item.json.reminderNumber }}/3): order #{{ $('Webhook Supabase').item.json.body.record.order_number }} ({{ $('Webhook Supabase').item.json.body.record.total_bdt }} BDT, TrxID {{ $('Webhook Supabase').item.json.body.record.trxid }}) still awaiting verification",
        "additionalFields": {}
      },
      "id": "wf1-tg-reminder",
      "name": "Telegram — Relance marchand",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1860, 540],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram bKash Bot" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $('Décider relance').item.json.canContinue }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-if-continue",
      "name": "IF relance < 3",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2080, 540]
    }
  ],
  "connections": {
    "Webhook Supabase": {
      "main": [[{ "node": "Filtre paiement_a_verifier", "type": "main", "index": 0 }]]
    },
    "Filtre paiement_a_verifier": {
      "main": [
        [{ "node": "Airtable — Upsert vérification", "type": "main", "index": 0 }],
        []
      ]
    },
    "Airtable — Upsert vérification": {
      "main": [[
        { "node": "Telegram — Notif admin", "type": "main", "index": 0 },
        { "node": "Resend — Paiement reçu", "type": "main", "index": 0 },
        { "node": "Attendre 10 min", "type": "main", "index": 0 }
      ]]
    },
    "Attendre 10 min": {
      "main": [[{ "node": "Supabase — Revérifier statut", "type": "main", "index": 0 }]]
    },
    "Supabase — Revérifier statut": {
      "main": [[{ "node": "Décider relance", "type": "main", "index": 0 }]]
    },
    "Décider relance": {
      "main": [[{ "node": "IF encore en attente", "type": "main", "index": 0 }]]
    },
    "IF encore en attente": {
      "main": [
        [{ "node": "Telegram — Relance marchand", "type": "main", "index": 0 }],
        []
      ]
    },
    "Telegram — Relance marchand": {
      "main": [[{ "node": "IF relance < 3", "type": "main", "index": 0 }]]
    },
    "IF relance < 3": {
      "main": [
        [{ "node": "Attendre 10 min", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
