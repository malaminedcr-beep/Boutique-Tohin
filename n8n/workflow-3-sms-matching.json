{
  "name": "bKash 3 — Matching automatique par SMS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bkash-sms-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf3-webhook",
      "name": "Webhook SMS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 320]
    },
    {
      "parameters": {
        "jsCode": "// Parsing SMS bKash. Regex validé sur les formats connus (Send Money reçu,\n// paiement marchand). ⚠️ À reconfirmer avec un VRAI SMS bKash de ton téléphone.\n// Ex : \"You have received Tk 1,540.00 from 01712345678. ... TrxID BHK7A2C9Q1 at 19/08/2026 15:42\"\nconst body = ($input.first().json.body) || {};\nconst text = String(body.text || body.message || body.sms || '');\nconst trxidMatch = text.match(/TrxID[:\\s]*([A-Z0-9]{6,})/i);\nconst amountMatch = text.match(/Tk[:\\s]*([\\d,]+(?:\\.\\d{1,2})?)/i);\nconst senderMatch = text.match(/from\\s+(01\\d{9})/i);\nreturn [{ json: {\n  text,\n  trxid: trxidMatch ? trxidMatch[1].toUpperCase() : null,\n  amount: amountMatch ? Number(amountMatch[1].replace(/,/g, '')) : null,\n  sender: senderMatch ? senderMatch[1] : null\n} }];"
      },
      "id": "wf3-code",
      "name": "Extraire TrxID (regex)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.trxid }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "wf3-if-trxid",
      "name": "IF TrxID trouvé",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/app8wnK5LRxNVaXq1/Verifications?maxRecords=1&filterByFormula=' + encodeURIComponent(\"AND({trxid}='\" + $json.trxid + \"',{statut}='A verifier')\") }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {}
      },
      "id": "wf3-search",
      "name": "Airtable — Rechercher TrxID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 240],
      "credentials": {
        "airtableTokenApi": { "id": "", "name": "Airtable Paiements bKash" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ ($json.records || []).length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        },
        "options": {}
      },
      "id": "wf3-if-found",
      "name": "IF ligne trouvée",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1080, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://api.airtable.com/v0/app8wnK5LRxNVaXq1/Verifications/' + $json.records[0].id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"fields\": { \"statut\": \"Paye\", \"verifie_par\": \"auto-sms\", \"verifie_le\": $now.toISO() } } }}",
        "options": {}
      },
      "id": "wf3-airtable-update",
      "name": "Airtable — Marquer Paye",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 180],
      "credentials": {
        "airtableTokenApi": { "id": "", "name": "Airtable Paiements bKash" }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "orders",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Airtable — Rechercher TrxID').item.json.records[0].fields.order_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "payment_status", "fieldValue": "paye" },
            { "fieldId": "verified_by", "fieldValue": "auto-sms" },
            { "fieldId": "verified_at", "fieldValue": "={{ $now.toISO() }}" }
          ]
        }
      },
      "id": "wf3-supabase",
      "name": "Supabase — Update orders (paye)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1520, 180],
      "credentials": {
        "supabaseApi": { "id": "", "name": "Supabase French Beauty" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: 'French Beauty BD <onboarding@resend.dev>', to: [ $('Supabase — Update orders (paye)').item.json.shipping_address.email ], subject: 'Paiement confirmé — commande ' + $('Supabase — Update orders (paye)').item.json.order_number, html: '<p>Bonjour,</p><p>Nous avons bien reçu votre paiement bKash pour la commande <b>' + $('Supabase — Update orders (paye)').item.json.order_number + '</b>. Merci pour votre confiance !</p><p>— French Beauty BD</p>' } }}",
        "options": {}
      },
      "id": "wf3-notif-client",
      "name": "Resend — Email client (paye)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 180],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Resend API" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-5162751576",
        "text": "=⚠️ SMS reçu mais format non reconnu : {{ $('Extraire TrxID (regex)').item.json.text }}",
        "additionalFields": {}
      },
      "id": "wf3-alert-format",
      "name": "Telegram — Alerte SMS non reconnu",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 500],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram bKash Bot" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-5162751576",
        "text": "=⚠️ TrxID reçu par SMS sans commande correspondante — vérification manuelle nécessaire.\nTrxID : {{ $('Extraire TrxID (regex)').item.json.trxid }}\nMontant : {{ $('Extraire TrxID (regex)').item.json.amount }} BDT\nExpéditeur : {{ $('Extraire TrxID (regex)').item.json.sender }}",
        "additionalFields": {}
      },
      "id": "wf3-alert-nomatch",
      "name": "Telegram — Alerte TrxID sans commande",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1300, 420],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "", "name": "Telegram bKash Bot" }
      }
    }
  ],
  "connections": {
    "Webhook SMS": {
      "main": [[{ "node": "Extraire TrxID (regex)", "type": "main", "index": 0 }]]
    },
    "Extraire TrxID (regex)": {
      "main": [[{ "node": "IF TrxID trouvé", "type": "main", "index": 0 }]]
    },
    "IF TrxID trouvé": {
      "main": [
        [{ "node": "Airtable — Rechercher TrxID", "type": "main", "index": 0 }],
        [{ "node": "Telegram — Alerte SMS non reconnu", "type": "main", "index": 0 }]
      ]
    },
    "Airtable — Rechercher TrxID": {
      "main": [[{ "node": "IF ligne trouvée", "type": "main", "index": 0 }]]
    },
    "IF ligne trouvée": {
      "main": [
        [{ "node": "Airtable — Marquer Paye", "type": "main", "index": 0 }],
        [{ "node": "Telegram — Alerte TrxID sans commande", "type": "main", "index": 0 }]
      ]
    },
    "Airtable — Marquer Paye": {
      "main": [[{ "node": "Supabase — Update orders (paye)", "type": "main", "index": 0 }]]
    },
    "Supabase — Update orders (paye)": {
      "main": [[{ "node": "Resend — Email client (paye)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
